{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "description": "While Datenanfragen.de is mostly run as a static site, some functionality does require a server. These endpoints are defined here.",
    "author": "The Datenanfragen.de project <dev@datenanfragen.de> (https://www.datenanfragen.de)",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "husky": "4.3.7",
        "lint-staged": "^13.2.2",
        "nodemon": "^3.1.14",
        "prettier": "^2.8.8"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@hapi/hapi": "^21.4.13",
        "@hapi/inert": "^7.1.3",
        "@hapi/vision": "^7.0.3",
        "@octokit/rest": "^19.0.8",
        "fast-xml-parser": "^5.3.4",
        "handlebars": "^4.7.7",
        "hapi-cron": "^1.1.0",
        "joi": "^18.3.2",
        "knex": "^3.3.0",
        "nanoid": "3.3.8",
        "nodemailer": "^7.0.11",
        "octokit-plugin-create-pull-request": "^4.2.2",
        "pm2": "^5.3.0",
        "sqlite3": "^6.0.1"
    },
    "scripts": {
        "dev": "nodemon -e js,mjs,json,html src/index.js",
        "prod": "pm2 startOrRestart ecosystem.config.js --no-daemon"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,css,scss,json}": [
            "prettier --write"
        ]
    }
}
